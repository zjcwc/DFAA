  # Create a dummy reference grid
  r_ref <- terra::rast(nrows=30, ncols=30, xmin=0, xmax=10, ymin=0, ymax=10, crs="EPSG:4326")
  
  # Helper to make time series rasters
  mk_ts <- function(n) terra::rast(replicate(n, {r<-r_ref; values(r)<-runif(ncell(r)); r}, simplify=FALSE))
  
  r_slope_raw <- r_ref; values(r_slope_raw) <- runif(ncell(r_ref), -0.5, 0.5)
  remain_ts   <- mk_ts(80) # Simulate 80 time steps
  tac_ts      <- mk_ts(80)
  
  # Dummy Predictors
  pred_rasters <- list()
  for(p in names(PATH_PREDS)) {
    r <- r_ref; values(r) <- runif(ncell(r), 0, 100)
    pred_rasters[[p]] <- r
  }
  
  # Dummy Zones
  zones_source <- r_ref; values(zones_source) <- sample(1:4, ncell(r_ref), replace=TRUE)
  names(zones_source) <- "clim4"
}

