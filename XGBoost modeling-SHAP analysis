# 1. Custom Beeswarm Plot
plot_custom_beeswarm <- function(sv, max_display=15) {
  shap_df <- as.data.frame(sv$S); feat_df <- as.data.frame(sv$X)
  imp <- colMeans(abs(shap_df))
  imp_df <- data.frame(feature=names(imp), importance=imp) %>% arrange(importance) %>% tail(max_display)
  
  plot_data <- list()
  for(f in imp_df$feature) {
    fv <- feat_df[[f]]
    # Normalize feature value for coloring
    fn <- if(sd(fv)==0) rep(0.5, length(fv)) else (fv-min(fv))/(max(fv)-min(fv))
    plot_data[[f]] <- data.frame(feature=f, shap=shap_df[[f]], val_norm=fn)
  }
  plot_data <- do.call(rbind, plot_data)
  plot_data$feature <- factor(plot_data$feature, levels=imp_df$feature)
  
  ggplot() +
    geom_col(data=imp_df, aes(x=importance, y=feature), fill="grey90", width=0.5) +
    ggbeeswarm::geom_quasirandom(data=plot_data, aes(x=shap, y=feature, color=val_norm), 
                                 groupOnX=FALSE, varwidth=TRUE, size=1.0, alpha=0.8, stroke=0) +
    scale_color_gradientn(colors=c("#2166AC","#92C5DE","#F7F7F7","#F4A582","#B2182B"), 
                          name="Feature\nValue") +
    scale_x_continuous(labels = function(x) format(x, scientific = FALSE, drop0trailing = TRUE)) +
    labs(x="SHAP Value (Impact on Resilience)", y=NULL) +
    theme_bw() +
    theme(text=element_text(family=PLOT_FONT_FAMILY),
          axis.text=element_text(size=AXIS_TEXT_SIZE, color="black"),
          axis.title=element_text(size=AXIS_TITLE_SIZE, face="bold"),
          legend.position="right")
}

# 2. Dependence Plot with GAM Smoothing
plot_shap_card <- function(sv, feat) {
  df <- data.frame(x=sv$X[, feat], shap=sv$S[, feat])
  # GAM Smoothing
  m <- mgcv::gam(shap ~ s(x, k=5), data=df)
  xp <- seq(min(df$x), max(df$x), length.out=200)
  pr <- predict(m, newdata=data.frame(x=xp), se.fit=TRUE)
  
  pd <- data.frame(x=xp, y=pr$fit, ymin=pr$fit-1.96*pr$se.fit, ymax=pr$fit+1.96*pr$se.fit)
  
  ggplot() +
    geom_point(data=df, aes(x, shap, color=x), alpha=0.3, size=1.5) +
    geom_ribbon(data=pd, aes(x=x, ymin=ymin, ymax=ymax), alpha=0.2) +
    geom_line(data=pd, aes(x, y), linewidth=1, color="black") +
    scale_color_gradientn(colors=c("#2166AC","#F7F7F7","#B2182B")) +
    scale_y_continuous(labels = function(x) format(x, scientific = FALSE)) +
    geom_hline(yintercept=0, linetype="dashed") +
    labs(x=feat, y="SHAP Value") +
    theme_bw() +
    theme(text=element_text(family=PLOT_FONT_FAMILY),
          axis.text=element_text(size=AXIS_TEXT_SIZE, color="black"),
          axis.title=element_text(size=AXIS_TITLE_SIZE, face="bold"),
          legend.position="none")
}

# 3. SHAP vs System State (Slope Quantiles)
plot_shap_vs_tau <- function(df_data, sv_obj, features) {
  # Create bins based on Slope quantiles (System State: Resilient -> Vulnerable)
  df_data$bin <- cut(df_data$slope, 
                     breaks = quantile(df_data$slope, probs=seq(0,1,0.1), na.rm=TRUE), 
                     include.lowest=TRUE, labels=FALSE)
  
  res <- list()
  for(f in features) {
    agg <- data.frame(bin=df_data$bin, shap=sv_obj$S[,f]) %>% 
      group_by(bin) %>% 
      summarise(m=mean(shap, na.rm=TRUE), se=sd(shap, na.rm=TRUE)/sqrt(n())) %>% 
      mutate(feature=f)
    # Map bin index to approximate Quantile (0.1, 0.2 ... 1.0)
    agg$tau <- agg$bin / 10 
    res[[f]] <- agg
  }
  pd <- do.call(rbind, res)
  
  ggplot(pd, aes(x=tau, y=m, group=feature)) +
    geom_ribbon(aes(ymin=m-1.96*se, ymax=m+1.96*se), fill="grey80", alpha=0.4) +
    geom_line(aes(color=m), linewidth=1.2) +
    geom_point(aes(color=m), size=3) +
    scale_color_gradient2(low="#1b7837", mid="#f6e8c3", high="#8c510a") +
    facet_wrap(~feature, scales="free_y") +
    geom_hline(yintercept=0, linetype="dashed") +
    scale_y_continuous(labels = function(x) format(x, scientific = FALSE)) +
    labs(x="Vulnerability Quantile (T)", y="Mean SHAP Value") +
    theme_bw() +
    theme(text=element_text(family=PLOT_FONT_FAMILY),
          axis.text=element_text(size=AXIS_TEXT_SIZE, color="black"),
          axis.title=element_text(size=AXIS_TITLE_SIZE, face="bold"),
          strip.text=element_text(size=14, face="bold"))
}

# 4. Interaction Surface Plot (Optional 2D Interaction)
plot_interaction_surf <- function(model, df, f1, f2) {
  # Prepare Grid
  x_range <- seq(min(df[[f1]]), max(df[[f1]]), length.out=50)
  y_range <- seq(min(df[[f2]]), max(df[[f2]]), length.out=50)
  grid <- expand.grid(x=x_range, y=y_range)
  names(grid) <- c(f1, f2)
  
  # Fill other features with median
  others <- setdiff(names(df), c(f1, f2))
  for(o in others) grid[[o]] <- median(df[[o]], na.rm=TRUE)
  
  # Predict
  dgrid <- xgb.DMatrix(as.matrix(grid[, preds]))
  grid$pred <- predict(model, dgrid)
  
  ggplot(grid, aes_string(x=f1, y=f2, z="pred")) +
    geom_contour_filled(bins=10) +
    labs(title=paste("Interaction:", f1, "vs", f2)) +
    theme_bw() + theme(text=element_text(family=PLOT_FONT_FAMILY))
}

