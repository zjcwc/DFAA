# 1. Rolling Standard Deviation with Padding Logic
#    Ensures the output length matches the input time series for stacking.
WIN <- 60; ALIGN <- "center"
roll_sd_vec <- function(v){
  n <- length(v); len <- n - WIN + 1
  if (!is.finite(len) || len <= 0 || all(is.na(v))) return(rep(NA_real_, len))
  # Standard calculation
  res <- as.numeric(zoo::rollapply(v, width=WIN, FUN=sd, align=ALIGN, na.rm=TRUE))
  # Note: If your TS length and window result differ, add padding logic here if necessary.
  return(res)
}

# 2. Linear Trend Calculation (Returns Slope & P-value)
lm_slope_p <- function(v){
  if (all(is.na(v))) return(c(NA_real_, NA_real_))
  t <- seq_along(v)
  # Basic lm
  fit <- try(lm(v ~ t), silent=TRUE)
  if (inherits(fit, "try-error")) return(c(NA, NA))
  sm <- summary(fit)
  if (nrow(sm$coefficients) < 2) return(c(NA, NA))
  c(sm$coefficients[2,1], sm$coefficients[2,4]) 
}

# 3. Strict Raster Alignment
#    Ensures predictors match the Grid, CRS, and Extent of the Target exactly.
align_to <- function(r, template, method="bilinear", categorical=FALSE){
  if (categorical) method <- "near"
  # 1. Reproject if CRS differs
  if (!terra::compareGeom(r, template, stopOnError=FALSE) || terra::crs(r) != terra::crs(template)) {
    r <- terra::project(r, template, method=method)
  }
  # 2. Resample to match resolution
  r <- terra::resample(r, template, method=method)
  # 3. Crop to extent
  r <- terra::crop(r, terra::ext(template))
  # 4. Mask by template
  terra::mask(r, template)
}

