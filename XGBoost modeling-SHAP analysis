# --- STEP 1: Rolling Variability Calculation ---
cat("[INFO] Step 1: Calculating Rolling SD...\n")
sd_ts <- terra::app(remain_ts, roll_sd_vec, cores=NCORES)

# [Constraint Logic] Ensure TS lengths match (Padding check)
if (terra::nlyr(sd_ts) != terra::nlyr(tac_ts)) {
  # In a real scenario, you might subset the layers here to match the valid window.
  # For demo purposes, we take the overlapping subset.
  n_min <- min(terra::nlyr(sd_ts), terra::nlyr(tac_ts))
  sd_ts <- sd_ts[[1:n_min]]
  tac_ts <- tac_ts[[1:n_min]]
}

# --- STEP 2: Linear Trend Calculation ---
cat("[INFO] Step 2: Calculating Linear Trends...\n")
tac_stats <- terra::app(tac_ts, lm_slope_p, cores=NCORES); names(tac_stats) <- c("slope", "p")
sd_stats  <- terra::app(sd_ts,  lm_slope_p, cores=NCORES); names(sd_stats)  <- c("slope", "p")

# --- STEP 3: Consistency Masking ---
cat("[INFO] Step 3: Applying Consistency Filter...\n")
keep_mask <- terra::lapp(c(tac_stats, sd_stats), fun=function(ts, tp, ss, sp){
  # 1. Trend must be significant (p < 0.05)
  sig_tac <- !is.na(tp) & (tp < 0.05)
  
  # 2. SD trend check: 
  # If SD trend is significant (p < 0.05), its sign should match the Trend sign (or specific logic)
  # Here: We exclude pixels where Mean trend and Variance trend are significantly OPPOSITE (Example Logic)
  opp_sd <- (!is.na(sp) & (sp < 0.05)) & (sign(ts) != sign(ss))
  
  ifelse(sig_tac & !opp_sd, 1, NA)
}, cores=NCORES)

r_slope <- terra::mask(r_slope_raw, keep_mask)
# Save intermediate result
# terra::writeRaster(r_slope, file.path(OUTPUT_DIR, "filtered_slope.tif"), overwrite=TRUE)

# --- STEP 4: Alignment & Extraction ---
cat("[INFO] Step 4: Aligning Rasters and Extracting Data...\n")

# Align all predictors to the masked slope map
aligned_preds <- lapply(pred_rasters, function(r) align_to(r, r_slope))
r_stack <- terra::rast(c(list(slope=r_slope), aligned_preds))

# Extract Data Points
pts <- terra::as.points(r_slope, na.rm=TRUE)
df_raw <- terra::extract(r_stack, pts, bind=FALSE) 
df_raw$ID <- NULL

# Handle Zones (Raster or Vector)
if (inherits(zones_source, "SpatVector")) {
  if (!terra::same.crs(zones_source, r_slope)) zones_source <- terra::project(zones_source, r_slope)
  z_vals <- terra::extract(zones_source, pts)
  # Find column with zone ID
  df_raw$clim4 <- z_vals[, grep("clim|zone|id", names(z_vals), ignore.case=TRUE)[1]]
} else {
  zones_r <- align_to(zones_source, r_slope, categorical=TRUE)
  z_vals <- terra::extract(zones_r, pts)
  df_raw$clim4 <- z_vals[,1]
}

